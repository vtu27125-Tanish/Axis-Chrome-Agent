{
  "manifest_version": 3,
  "name": "Axis AI",
  "short_name": "Axis",
  "version": "3.0.0",
  "description": "Autonomous AI Browser Agent powered by Gemini",

  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "sidePanel",
    "offscreen",
    "bookmarks",
    "notifications",
    "alarms",
    "contextMenus"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Axis AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "popup/pcm-processor.js",
        "popup/audio-player-worklet.js",
        "content/pcm-processor.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+A"
      },
      "description": "Open Axis AI"
    }
  },

  "key": ""
}